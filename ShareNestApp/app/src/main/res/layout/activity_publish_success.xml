<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:background="#247B53">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:src="@drawable/back"
                android:contentDescription="Quay lại"
                android:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Đăng bài thành công"
                android:textColor="#ffffff"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- NỘI DUNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="38dp"
            android:paddingBottom="24dp">

            <!-- ICON THÀNH CÔNG -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/mark"
                    android:contentDescription="Thành công" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Đăng bài thành công!"
                android:textColor="#23312A"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Vật phẩm của bạn đã sẵn sàng để mọi người quanh đây tìm thấy. Cảm ơn bạn đã sẻ chia!"
                android:textColor="#777777"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- THẺ VẬT PHẨM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:padding="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_success_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgProduct"
                        android:layout_width="94dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_input_product"
                        android:contentDescription="Ảnh vật phẩm"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtProductName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tên vật phẩm"
                            android:textColor="#23312A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/txtProductStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="5dp"
                            android:background="@drawable/bg_success_status"
                            android:text="● Còn khả dụng"
                            android:textColor="#247B53"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtCreatedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Đang tải ngày đăng..."
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnMore"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/more"
                        android:contentDescription="Tùy chọn"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- LƯỢT YÊU CẦU -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/user"
                        android:contentDescription="Yêu cầu nhận" />

                    <TextView
                        android:id="@+id/txtRequestCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="0 yêu cầu nhận"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- CHỈNH SỬA VÀ XÓA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnEditProduct"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_edit_product"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="18dp"
                            android:contentDescription="Chỉnh sửa"
                            android:src="@drawable/pencil" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="Chỉnh sửa"
                            android:textColor="#247B53"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnDeleteProduct"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_delete_product"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/delete"
                            android:contentDescription="Xóa" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="Xóa"
                            android:textColor="#D94343"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- XEM BÀI ĐĂNG CỦA TÔI -->
            <Button
                android:id="@+id/btnViewMyPosts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Xem bài đăng của tôi"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#247B53" />

            <!-- VỀ TRANG CHỦ -->
            <TextView
                android:id="@+id/btnGoHome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_outline"
                android:gravity="center"
                android:text="Về trang chủ"
                android:textColor="#247B53"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
