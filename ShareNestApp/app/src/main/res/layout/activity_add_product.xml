<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#247B53">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/back"
                android:tint="#ffffff"
                android:contentDescription="Quay lại"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Đăng nhu yếu phẩm"
                android:textStyle="bold"
                android:textSize="19sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- NỘI DUNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chia sẻ vật phẩm còn hữu ích với người quanh bạn. Các mục có dấu * là bắt buộc."
                android:textSize="13sp"
                android:textColor="#777777"
                android:layout_marginBottom="18dp" />

            <!-- TÊN VẬT PHẨM -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên vật phẩm *"
                android:textStyle="bold"
                android:textColor="#303030"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtProductName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_product"
                android:paddingHorizontal="14dp"
                android:hint="Ví dụ: Áo khoác mùa đông"
                android:singleLine="true"
                android:inputType="textCapSentences"
                android:textSize="14sp" />

            <!-- DANH MỤC -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Danh mục *"
                android:textStyle="bold"
                android:textColor="#303030"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_product"
                android:paddingHorizontal="12dp" />

            <!-- SỐ LƯỢNG VÀ TÌNH TRẠNG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- SỐ LƯỢNG -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Số lượng *"
                        android:textStyle="bold"
                        android:textColor="#303030"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_product"
                        android:paddingHorizontal="12dp"
                        android:inputType="number"
                        android:singleLine="true"
                        android:text="1"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- TÌNH TRẠNG -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tình trạng *"
                        android:textStyle="bold"
                        android:textColor="#303030"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spCondition"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_product"
                        android:paddingHorizontal="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tình trạng vật lý của vật phẩm, không phải trạng thái bài đăng."
                android:textColor="#888888"
                android:textSize="12sp" />

            <!-- MÔ TẢ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mô tả *"
                android:textStyle="bold"
                android:textColor="#303030"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_product"
                android:padding="14dp"
                android:gravity="top"
                android:hint="Mô tả kích thước, chất liệu và lưu ý khi sử dụng..."
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="14sp" />

            <!-- HÌNH ẢNH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hình ảnh *"
                    android:textStyle="bold"
                    android:textColor="#303030"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtImageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/5 ảnh"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <!-- KHU VỰC THÊM ẢNH -->

            <!-- KHU VỰC THÊM ẢNH -->
            <LinearLayout
                android:id="@+id/layoutImagePreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_image_upload"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgAddPhoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/gallery"
                    android:contentDescription="Thêm ảnh" />

                <TextView
                    android:id="@+id/txtAddPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="Thêm ảnh"
                    android:textColor="#247B53"
                    android:textSize="13sp"
                    android:includeFontPadding="false" />

            </LinearLayout>


            <!-- NÚT CHỤP ẢNH VÀ THƯ VIỆN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- CHỤP ẢNH -->
                <LinearLayout
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_location_selected"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/camera"
                        android:contentDescription="Chụp ảnh" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Chụp ảnh"
                        android:textSize="13sp"
                        android:textColor="#247B53" />
                </LinearLayout>

                <!-- CHỌN TỪ THƯ VIỆN -->
                <LinearLayout
                    android:id="@+id/btnChooseImages"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_location_selected"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/photo"
                        android:contentDescription="Chọn ảnh từ thư viện" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Chọn từ thư viện"
                        android:textSize="13sp"
                        android:textColor="#247B53" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tối đa 5 ảnh · JPG, PNG · Mỗi ảnh không quá 10 MB"
                android:textSize="12sp"
                android:textColor="#888888" />

            <!-- VỊ TRÍ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Vị trí *"
                android:textStyle="bold"
                android:textColor="#303030"
                android:textSize="14sp" />

            <!-- SỬ DỤNG VỊ TRÍ HIỆN TẠI -->
            <LinearLayout
                android:id="@+id/btnUseCurrentLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_location_selected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/placeholder"
                    android:contentDescription="Vị trí hiện tại" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Sử dụng vị trí hiện tại"
                    android:textColor="#247B53"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- CHỌN VỊ TRÍ TRÊN BẢN ĐỒ -->
            <LinearLayout
                android:id="@+id/btnChooseLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input_product"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/placeholder"
                    android:contentDescription="Chọn vị trí" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Chọn vị trí"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/mui_ten_1"
                    android:contentDescription="Mở bản đồ" />
            </LinearLayout>

            <!-- ĐỊA CHỈ ĐÃ CHỌN -->
            <TextView
                android:id="@+id/txtProductAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_location_selected"
                android:padding="14dp"
                android:text="Chưa chọn địa chỉ"
                android:textSize="13sp"
                android:textColor="#555555" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chỉ khu vực gần đúng được hiển thị công khai."
                android:textSize="12sp"
                android:textColor="#888888" />

            <!-- NÚT ĐĂNG BÀI -->
            <Button
                android:id="@+id/btnPublishProduct"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:text="Đăng bài"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#247B53" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
